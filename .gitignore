# Whitelist gitignore: everything is ignored unless named below
# To track something new, name it here.
*

# Root files 〜 each present solely by its own named grant; an unnamed root file is invisible
!/.gitignore
!/.gitmodules
!/.clangd
!/flake.nix
!/flake.lock
!/CMakeLists.txt
!/build.sh
!/build.bat
!/README.md
!/COPYING
!/COPYING.LESSER
!/ATTRIBUTIONS.md

# Engine sources: C23/C++23, module CMake lists, module notes
!/src/
!/src/**/
!/src/**/*.c
!/src/**/*.cpp
!/src/**/*.h
!/src/**/*.md
!/src/**/CMakeLists.txt

# Public interface headers
!/include/
!/include/**/
!/include/**/*.h
!/include/**/*.md

# Tests: sources, registration, templates, fixtures
!/tests/
!/tests/**/
!/tests/**/*.c
!/tests/**/*.h
!/tests/**/*.md
!/tests/**/CMakeLists.txt
!/tests/**/*.anofix

# CMake modules
!/cmake/
!/cmake/**/
!/cmake/**/*.cmake
!/cmake/**/*.md

# Docs: markdown plus the checked-in references (miniaudio.h, shadertoy txt, canvas tsx)
!/docs/
!/docs/**/
!/docs/**/*.md
!/docs/**/*.txt
!/docs/**/*.h
!/docs/**/*.tsx

# Runtime resources: shader sources + compiled spv, fonts + licenses, images, notes
!/resources/
!/resources/**/
!/resources/**/*.comp
!/resources/**/*.frag
!/resources/**/*.vert
!/resources/**/*.task
!/resources/**/*.mesh
!/resources/**/*.glsl
!/resources/**/*.spv
!/resources/**/*.ttf
!/resources/**/*.png
!/resources/**/*.jpg
!/resources/**/*.md
!/resources/**/*.txt
!/resources/**/*.sh

# Profiling data
!/profile/
!/profile/**/
!/profile/**/*.csv
!/profile/**/*.yaml

# Tools: generators and the perf harness drivers (tools/perf/bench_fps.md); no other python
!/tools/
!/tools/**/
!/tools/**/*.c
!/tools/**/*.md
!/tools/perf/bench_fps_*.py

# Vendored submodules (gitlinks 〜 their own .gitignore governs their trees) and shim headers/notes
!/external/
!/external/**/
!/external/**/*.h
!/external/**/*.md

# CI
!/.github/
!/.github/**/
!/.github/**/*.yml

# Claude harness: shared settings, skills, hooks, tools, agents; settings.local.json stays local
!/.claude/
!/.claude/settings.json
!/.claude/settings.json.bak
!/.claude/skills/
!/.claude/skills/**
!/.claude/hooks/
!/.claude/hooks/**
!/.claude/tools/
!/.claude/tools/**
!/.claude/agents/
!/.claude/agents/**/
!/.claude/agents/**/*.md

# Junk the wide grants above must not readmit (parity with the pre-whitelist shapes)
.DS_Store
*.swp
*.swo
*~
.~lock.*#
__pycache__/
*.pyc
*.o
*.obj
*.d
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.out
*.zip
*.pdb
*.dSYM/
docs/artifacts/
docs/study/
tools/ucd/

# The archive is closed except for archiving itself (retired .md documents)
docs/.archive/**
!/docs/.archive/*.md

# Names the old denylist banned outright; the .txt/.md pins above must not readmit them
requirements.txt
setup.py
setup.cfg
pyproject.toml
Pipfile
Pipfile.lock
poetry.lock
llms.txt
llms-full.txt
CLAUDE.md
AGENTS.md
AGENTS.override.md
SKILL.md
!/.claude/skills/**/SKILL.md
