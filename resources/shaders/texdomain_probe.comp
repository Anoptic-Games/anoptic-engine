#version 450
#extension GL_EXT_nonuniform_qualifier : require

// Texture-domain probe. Two lanes sample one mutable-format image through two bindless views.
// in:  srgbIndex, unormIndex (push constants)
// out: probe[0] = srgb sample RGBA, probe[1] = unorm sample RGBA

layout(local_size_x = 2) in;

layout(set = 0, binding = 0) writeonly buffer ProbeSSBO { vec4 probe[]; };
layout(set = 1, binding = 0) uniform sampler2D textures[];

layout(push_constant) uniform ProbePush {
    uint srgbIndex;
    uint unormIndex;
} pc;

void main() {
    uint lane = gl_LocalInvocationID.x;
    if (lane > 1u) return;
    uint slot = lane == 0u ? pc.srgbIndex : pc.unormIndex;
    probe[lane] = textureLod(textures[nonuniformEXT(slot)], vec2(0.5), 0.0);
}
