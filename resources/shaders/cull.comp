#version 450
#extension GL_EXT_nonuniform_qualifier : require  // index hizPyramid[] by view
#extension GL_GOOGLE_include_directive : require

#include "gpu_abi.glsl"

layout(local_size_x = 256) in;

// ---------------------------------------------------------------------------
// Resources & bindings
// ---------------------------------------------------------------------------

// Must match structs.h ANO_VIEW_COUNT. One frustum per render view.
#define ANO_VIEW_COUNT 2u

layout(set = 0, binding = 0) uniform CullUBO { CullData cull; };

layout(set = 0, binding = 1) readonly buffer TransformSSBO {
    mat4 transforms[];
};

layout(set = 0, binding = 2) readonly buffer EntitySSBO {
    EntityInfo entities[];
};

// LOD level in high bits of the compacted entity index: 3 bits (ANO_MAX_LOD 8) + 29-bit index.
#define ANO_LOD_LEVEL_SHIFT  29u
#define ANO_ENTITY_INDEX_MASK 0x1FFFFFFFu

layout(set = 0, binding = 3) readonly buffer MeshSSBO {
    MeshData meshDrawData[];
};

layout(set = 0, binding = 4) readonly buffer MeshBoundsSSBO {
    vec4 meshBounds[];
};

// Selects the indirect command format below. Mesh path: entity via compacted-index buffer + gl_DrawID.
// Fallback path: draw ordinal packed into firstInstance (gl_InstanceIndex).
layout(constant_id = 1) const bool useMeshShader = true;

// Raw u32 view of the indirect buffer:
//   mesh path     -> VkDrawMeshTasksIndirectCommandEXT (3 u32)
//   fallback path -> VkDrawIndexedIndirectCommand (5 u32)
layout(set = 0, binding = 5) buffer IndirectBuffer {
    uint indirectData[];
};

layout(set = 0, binding = 6) buffer DrawCount {
    uint drawCounts[];
};

layout(set = 0, binding = 7) writeonly buffer CompactedEntityIndices {
    uint entityIndices[];
};

layout(set = 0, binding = 8) readonly buffer MaterialSSBO {
    MaterialData materials[];
};

// Shadow frustums, GPU-built by shadowsetup.comp. Survivors written into one slot-0 partition each
// after the camera partitions (ANO_VIEW_COUNT*drawSlotCount + s). Must match structs.h; uses only the 6 planes.
#define ANO_SHADOW_FRUSTUM_COUNT 42u  // must match structs.h (static 26 + runtime 16)
layout(set = 0, binding = 9) readonly buffer ShadowFrustumSSBO { CullView shadowFrustums[]; };

// Per-draw depth key for the transparency sort, at sortKeys[view*maxEntities + writeIdx].
// tpsort.comp reorders the partition back-to-front. Sized for camera partitions only.
layout(set = 0, binding = 10) writeonly buffer SortKeys { float sortKeys[]; };

// Per-camera-view Hi-Z occlusion pyramids. hizPyramid[view] is last frame's pyramid for that view.
// Indexed by the dynamically-uniform `view` via nonuniformEXT.
layout(set = 0, binding = 11) uniform sampler2D hizPyramid[ANO_VIEW_COUNT];

// ---------------------------------------------------------------------------
// Visibility tests
// ---------------------------------------------------------------------------

// World-space bounding sphere vs one view's 6 frustum planes.
bool isVisibleIn(uint view, vec4 worldCenter, float worldRadius) {
    for (int i = 0; i < 6; i++) {
        if (dot(cull.views[view].frustumPlanes[i], worldCenter) < -worldRadius) {
            return false;
        }
    }
    return true;
}

bool isVisibleInShadow(uint s, vec4 worldCenter, float worldRadius) {
    for (int i = 0; i < 6; i++) {
        if (dot(shadowFrustums[s].frustumPlanes[i], worldCenter) < -worldRadius) {
            return false;
        }
    }
    return true;
}

// ---------------------------------------------------------------------------
// Draw emission
// ---------------------------------------------------------------------------

// Append compacted draw for entity idx (LOD level) into partition partIdx. Returns writeIdx.
uint emitDraw(uint partIdx, uint idx, MeshData mData, uint level) {
    uint writeIdx = atomicAdd(drawCounts[partIdx], 1);
    uint destIdx = partIdx * cull.maxEntities + writeIdx;
    if (useMeshShader) {
        uint b = destIdx * 3u;
        indirectData[b + 0u] = cull.taskParams.x != 0u
            ? (mData.meshletCount + 31u) / 32u     // task path: 32-meshlet workgroups (flat.task)
            : mData.meshletCount;                  // direct path: one workgroup per meshlet
        indirectData[b + 1u] = 1u;
        indirectData[b + 2u] = 1u;
    } else {
        uint b = destIdx * 5u;
        indirectData[b + 0u] = mData.classicIndexCount;  // indexCount
        indirectData[b + 1u] = 1u;                       // instanceCount
        indirectData[b + 2u] = mData.classicFirstIndex;  // firstIndex
        indirectData[b + 3u] = mData.vertexOffset / 32u; // vertexOffset -> gl_VertexIndex base
        indirectData[b + 4u] = writeIdx;                 // firstInstance = draw ordinal (gl_InstanceIndex)
    }
    entityIndices[destIdx] = (idx & ANO_ENTITY_INDEX_MASK) | (level << ANO_LOD_LEVEL_SHIFT);
    return writeIdx;
}

// ---------------------------------------------------------------------------
// LOD selection
// ---------------------------------------------------------------------------

// LOD from projected px radius rpx. level 1 at thresholdPx; each halving drops a level. bias: +coarser. Clamped [0, lodCount-1].
uint lodSelect(float rpx, uint lodCount, float thresholdPx, int bias) {
    if (lodCount <= 1u) return 0u;
    int autoLevel = 0;
    if (thresholdPx > 0.0 && rpx > 0.0) {
        float l = floor(log2(thresholdPx / rpx));
        if (l > 0.0) autoLevel = int(l);
    }
    int level = autoLevel + bias;
    if (level < 0) level = 0;
    if (level > int(lodCount) - 1) level = int(lodCount) - 1;
    return uint(level);
}

// ---------------------------------------------------------------------------
// Hi-Z occlusion
// ---------------------------------------------------------------------------

// Hi-Z: reproject sphere via prevViewProj, MAX depth over 4 AABB-corner mip texels.
// Occluded iff nearest sphere point is behind that occluder. false (keep) if disabled/behind eye.
bool isOccluded(uint view, vec4 worldCenter, float worldRadius) {
    if (cull.hizParams[view].z < 1.0) return false;                 // mipCount 0 => test off
    vec4 clip = cull.prevViewProj[view] * worldCenter;
    if (clip.w <= 0.0) return false;                                // straddles/behind last-frame eye
    float invW = 1.0 / clip.w;
    vec2 ndcC = clip.xy * invW;
    float rx = worldRadius * cull.hizProj[view].x * invW;           // perspective NDC radius (proj00)
    float ry = worldRadius * abs(cull.hizProj[view].y) * invW;      //                       (proj11)
    vec2 uvMin = clamp((ndcC - vec2(rx, ry)) * 0.5 + 0.5, 0.0, 1.0);
    vec2 uvMax = clamp((ndcC + vec2(rx, ry)) * 0.5 + 0.5, 0.0, 1.0);
    float spanX = (uvMax.x - uvMin.x) * cull.hizParams[view].x;     // AABB extent in base-res px
    float spanY = (uvMax.y - uvMin.y) * cull.hizParams[view].y;
    int lvl = int(clamp(ceil(log2(max(max(spanX, spanY), 1.0))), 0.0, cull.hizParams[view].z - 1.0));
    ivec2 ms = textureSize(hizPyramid[nonuniformEXT(view)], lvl);
    ivec2 tmin = clamp(ivec2(uvMin * vec2(ms)), ivec2(0), ms - 1);
    ivec2 tmax = clamp(ivec2(uvMax * vec2(ms)), ivec2(0), ms - 1);
    float hizMax = max(
        max(texelFetch(hizPyramid[nonuniformEXT(view)], tmin, lvl).r,
            texelFetch(hizPyramid[nonuniformEXT(view)], ivec2(tmax.x, tmin.y), lvl).r),
        max(texelFetch(hizPyramid[nonuniformEXT(view)], ivec2(tmin.x, tmax.y), lvl).r,
            texelFetch(hizPyramid[nonuniformEXT(view)], tmax, lvl).r));
    // Nearest sphere point projected to ZO NDC. clip.w == -viewZ == dist, nearW == dist - radius.
    // ndc = (proj22*vz + proj32) / clip.w.
    float nearW = clip.w - worldRadius;
    if (nearW <= 0.0) return false;                                 // nearest point at/behind the eye
    float vzNear = -nearW;
    float nearestNdc = (cull.hizProj[view].z * vzNear + cull.hizProj[view].w) / nearW;
    return nearestNdc > hizMax;
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx >= cull.entityCount) {
        return;
    }

    EntityInfo entity = entities[idx];

    // Transform-only entities (e.g. pure lights) carry no geometry.
    if (entity.meshIndex == 0xFFFFFFFFu) {
        return;
    }

    mat4 model = transforms[idx];
    // meshIndex = LOD base. Bounds/frustum use base; draw uses base+level.
    uint baseMesh = entity.meshIndex;
    vec4 bounds = meshBounds[baseMesh];
    MeshData baseData = meshDrawData[baseMesh];
    uint lodCount = baseData.lodCount;

    // Look up pipeline type, map it to its compacted draw partition. Non-drawing types map to the sentinel.
    uint pipelineType = materials[entity.materialIndex].pipelineType;
    uint slot = cull.drawSlotOf[pipelineType >> 2u][pipelineType & 3u];
    if (slot == 0xFFFFFFFFu) {
        return;
    }

    // World bounding sphere, tested against every view's frustum below.
    vec4 worldCenter = model * vec4(bounds.xyz, 1.0);
    float maxScale = max(max(length(model[0].xyz), length(model[1].xyz)), length(model[2].xyz));
    float worldRadius = bounds.w * maxScale;

    // Single-pass multi-frustum: test against every camera + shadow frustum, append one draw per survivor.
    // Camera partitions = view*drawSlotCount + slot, shadow partitions = ANO_VIEW_COUNT*drawSlotCount + s.
    for (uint view = 0u; view < cull.viewCount; ++view) {
        if (isVisibleIn(view, worldCenter, worldRadius)) {
            // dist = clip.w == -view_z, positive in front of the eye. Drives screen-area cull + sort key.
            float dist = (cull.views[view].viewProj * worldCenter).w;
            // Screen-area cull: drop if (worldRadius*scale)^2 < threshSq * dist^2. dist<=0 bypasses; threshSq 0 disables.
            float rnum = worldRadius * cull.viewCullParams[view].x;
            if (dist > 0.0 && rnum * rnum < cull.viewCullParams[view].y * dist * dist) {
                continue;
            }
            // Hi-Z occlusion cull: reject entities behind last frame's depth pyramid. Per-view gated, camera views only.
            if (isOccluded(view, worldCenter, worldRadius)) {
                continue;
            }
            // LOD select: rpx = rnum / dist. Only divides when LOD is present (lodCount>1).
            uint level = 0u;
            if (lodCount > 1u && dist > 0.0) {
                level = lodSelect(rnum / dist, lodCount, cull.viewCullParams[view].z, int(cull.viewCullParams[view].w));
            }
            MeshData mData = (level == 0u) ? baseData : meshDrawData[baseMesh + level];
            uint w = emitDraw(view * cull.drawSlotCount + slot, idx, mData, level);
            // Transmission lane only. Larger key = farther, tpsort.comp sorts descending (back-to-front).
            if (slot == cull.specialSlots.y) {
                sortKeys[view * cull.maxEntities + w] = dist;
            }
        }
    }
    // Shadow: opaque+transmission -> solid (base+s); MASKED -> base+FRUSTUM_COUNT+s. Additive casts none.
    uint shadowSub = (slot == cull.specialSlots.z) ? ANO_SHADOW_FRUSTUM_COUNT : 0u;
    if (slot != cull.specialSlots.x) {
        // Shadow LOD = view 0 lodSelect (threshold + bias + shadowLodBias). Same level for all shadow frustums.
        uint slevel = 0u;
        if (lodCount > 1u) {
            float cdist = (cull.viewCount > 0u) ? (cull.views[0].viewProj * worldCenter).w : 0.0;
            float crpx  = (cdist > 0.0) ? (worldRadius * cull.viewCullParams[0].x / cdist) : 0.0;
            slevel = lodSelect(crpx, lodCount, cull.viewCullParams[0].z,
                               int(cull.viewCullParams[0].w) + cull.shadowLodBias);
        }
        MeshData sData = (slevel == 0u) ? baseData : meshDrawData[baseMesh + slevel];
        for (uint s = 0u; s < ANO_SHADOW_FRUSTUM_COUNT; ++s) {
            if (isVisibleInShadow(s, worldCenter, worldRadius)) {
                emitDraw(ANO_VIEW_COUNT * cull.drawSlotCount + shadowSub + s, idx, sData, slevel);
            }
        }
    }
}
