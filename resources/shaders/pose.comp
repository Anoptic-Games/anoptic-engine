#version 450

// SKELETON. Not in CMakeLists shader manifest. Not loaded by any pipeline.
// Pose pre-pass: bone palette for every visible skinned instance.
// Draw stage (skinned.mesh) only fetches the result.
//
// Per visible skinned instance (one invocation):
//   1. sample clip(s) at (global.time - clipStartPhase), cross-fade A->B
//   2. parent-first skeleton walk (topological bone order) -> world transforms
//   3. multiply by inverse-bind matrix
//   4. write boneCount matrices into compacted palette region
// Cost: O(visible skinned bones). One thread per instance.
//
// Activate: add to manifest, PIPELINE_SKINNED compute sibling,
// dispatch after cull (palette base assigned) and before skinned draw.

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint visibleSkinnedCount;
} pc;

// {rigId, clipA, clipB, blendStart, blendDuration, clipStartPhase}
// mirrors SkinInstanceState (structs.h). Sparse skinned slots, compacted for the pass.
struct SkinInstanceState {
    uint  rigId;
    uint  clipA;
    uint  clipB;
    float blendStart;
    float blendDuration;
    float clipStartPhase;
};

layout(set = 0, binding = 0) uniform GlobalUBO {
    mat4  view;
    mat4  proj;
    float time;
    float deltaTime;
    uint  frameCount;
    uint  lightCount;
    vec4  cameraPos;
} global;

layout(set = 0, binding = 1) readonly  buffer SkinStateSSBO  { SkinInstanceState instances[]; } skinBuf;
// Static rig assets (parent table, inverse-bind, clip tracks).
// Shared, indexed by rigId. Declared by the real pass.
// layout(set = 0, binding = 2) readonly buffer RigSSBO   { ... } rigBuf;
// layout(set = 0, binding = 3) readonly buffer ClipSSBO  { ... } clipBuf;
layout(set = 0, binding = 4) writeonly buffer BonePaletteSSBO { mat4 palette[]; } paletteBuf;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.visibleSkinnedCount) return;

    // SKELETON: sample clip -> parent-first skeleton walk -> * inverse-bind ->
    // paletteBuf.palette[paletteBase + bone]. No-op until the rig/clip buffers land.
}
